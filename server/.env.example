# server 环境样例：复制为 server/.env（或放仓库根 .env，两处都会被加载；就近优先）
# 优先级：process env > server/.env > 仓库根 .env

PORT=3000

# 对应 docker-compose.yml 里的 Postgres 17
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aipodcast

# 媒体根目录（audio_ref/artifact_ref 都是相对它的相对路径）；默认 <repo>/media，已 gitignore
# MEDIA_ROOT=./media

# DashScope（M3 写稿 / M4 TTS 才用到；M0 可不填）
# 注意 BASE_URL 只填主机，代码会拼 /compatible-mode/v1 后缀（OpenAI 兼容端点）
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 写稿 LLM 模型 id（DashScope OpenAI 兼容端点；写稿大师专用 provider 配置见 modules/writer/session.ts）
# WRITER_MODEL=qwen3.7-plus

# 写稿会话 JSONL 目录（一集一个文件，conversations.session_file 存绝对路径）；默认 <repo>/data/sessions，已 gitignore
# SESSIONS_DIR=./data/sessions

# 资源检索形态：hybrid = BM25 + 向量双通道 RRF 等权融合（缺省）；
# bm25 = 纯全文（专名/编号精确，省 DashScope 额度）；
# vector = 纯语义（近义改写召回）。
# 只影响检索层——摄入不调 embedder（新资源状态 'pending'，用户在设置页「向量化」按钮触发），
# 切换此开关零重摄入成本
# RETRIEVAL_MODE=hybrid
