{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "spike": "tsx scripts/spike-pi-embed.ts",
    "spike-bm25": "tsx scripts/spike-bm25.ts",
    "spike-embedding": "tsx scripts/spike-embedding.ts",
    "spike-markitdown": "tsx scripts/spike-markitdown.ts",
    "spike-tts": "tsx scripts/spike-tts.ts"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@fastify/multipart": "^10.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
}
