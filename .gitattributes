# 默认：按内容自动处理文本文件，提交时统一为 LF
* text=auto

# 源代码与配置文件强制 LF
*.js    text eol=lf
*.ts    text eol=lf
*.jsx   text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.svg   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf

# Windows 脚本强制 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 图片
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary

# 音频（播客项目常用）
*.mp3   binary
*.wav   binary
*.m4a   binary
*.aac   binary
*.ogg   binary
*.flac  binary

# 视频 / 字体 / 归档
*.mp4   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
